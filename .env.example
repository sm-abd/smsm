# ─── Sanity (the CMS) ───────────────────────────────────────────────────────
# Leave the project ID blank and the site renders its built-in starter
# content, so you can develop without an account. The value below is this
# site's real project; it is a public identifier, not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=pav1anhp
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20

# SECRET — never commit a real value. Only needed to run `npm run seed`.
# Create at https://sanity.io/manage → API → Tokens, with Editor permissions.
# Put the real token in .env.local (git-ignored) and in the Vercel dashboard.
SANITY_API_WRITE_TOKEN=

# ─── Enquiry email (Resend) ─────────────────────────────────────────────────
# Without these the contact form logs to the server console in development and
# fails loudly in production, rather than silently dropping an enquiry.
# Free tier: https://resend.com
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=desk@sudhasquare.com
# Must be a verified domain in Resend. The default below works for testing only.
ENQUIRY_FROM_EMAIL="Sudha Square <onboarding@resend.dev>"

# ─── Site ───────────────────────────────────────────────────────────────────
# Used for canonical URLs, the sitemap, and social share cards.
NEXT_PUBLIC_SITE_URL=https://sudhasquare.com
